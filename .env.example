# Diagnostix CDSS — environment variables.
# Copy to .env and edit. start.sh and start-windows.bat load .env automatically;
# otherwise export the variables in your shell. Every variable is optional.

# Data source mode: live (call openFDA/RxNorm, cache results, serve stale cache on failure)
# | offline (never touch the network; cache and local databases only) | fixtures (synthetic test data — tests only)
DX_SOURCES=live

# openFDA API key (free: https://open.fda.gov/apis/authentication/). Raises the limit from 1,000 to 120,000 requests/day.
OPENFDA_API_KEY=

# AI rationale layer: hf (load a Hugging Face model locally) | stub (canned text, no download) | off (knowledge-base text only)
DX_LLM=hf

# Hugging Face model id for DX_LLM=hf. Low-RAM machines: Qwen/Qwen2.5-0.5B-Instruct
DX_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Model precision for DX_LLM=hf: auto | float32 | bfloat16 | float16
DX_DTYPE=auto

# Folder for the SQLite databases (cache, DDInter, audit ledger, patients). Default: backend/data
# DX_DATA_DIR=backend/data

# HTTP port for the server (binds to 127.0.0.1 only)
PORT=8000

# Where Hugging Face stores downloaded model weights (read by the transformers library, not by the app).
# Default is ~/.cache/huggingface, outside the repo. If you point it inside the repo, use .hf-cache/ (git-ignored).
# HF_HOME=.hf-cache
